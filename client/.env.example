# Where the Vite dev server forwards /api and /socket.io (dev only; read by vite.config.ts)
API_PROXY_TARGET=http://localhost:4000

# Optional. Leave empty to call the API on the same origin (recommended: dev proxy, or a reverse
# proxy in production). Set to e.g. https://api.example.com if the API lives on another origin;
# then CLIENT_ORIGIN on the API must be this app's origin so CORS and cookies work.
VITE_API_URL=
