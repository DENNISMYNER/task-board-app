NODE_ENV=development
PORT=4000

# Used by the app (driver adapter) and by the Prisma CLI (prisma.config.ts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskboard"

# Origin of your frontend (CORS + Socket.io). Vite's default is 5173.
CLIENT_ORIGIN="http://localhost:5173"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-at-least-32-random-characters"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
